{
  "$comment": "Manifest of every TextHue distribution. tools/sync-shared.py, tools/check-version.py, and tools/lint-go.py read this file directly; tools/verify.py and tools/build-packages.py read package-specific paths and commands from it while keeping their own explicit, dependency-ordered step sequence (the steps are not independent enough to run as a generic per-package loop: Python and Go's tests both require the npm package to be built first, for example). See CONTRIBUTING.md for how to add a new package.",
  "packages": [
    {
      "id": "npm",
      "language": "javascript",
      "dir": "packages/npm",
      "versionFiles": [
        { "path": "package.json", "kind": "json", "field": "version" },
        { "path": "packages/npm/package.json", "kind": "json", "field": "version" }
      ],
      "sharedFiles": ["SPECIFICATION.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
      "conformanceRunner": ["node", "tools/conformance-js.mjs"],
      "conformanceReplay": true,
      "coverageFlag": "javascript",
      "archiveRequiredFiles": [
        "assets/gallery.svg", "dist/index.js", "dist/index.d.ts", "dist/single.js", "dist/single.d.ts", "src/index.ts", "README.md",
        "SPECIFICATION.md", "LICENSE", "THIRD_PARTY_NOTICES.md",
        "examples/browser.html", "examples/typescript.ts"
      ],
      "publish": { "registry": "npm", "packageName": "texthue" }
    },
    {
      "id": "python",
      "language": "python",
      "dir": "packages/python",
      "versionFiles": [
        { "path": "packages/python/pyproject.toml", "kind": "toml", "field": ["project", "version"] },
        { "path": "packages/python/src/texthue/__init__.py", "kind": "pyRegex",
          "pattern": "^__version__ = \"([^\"]+)\"$" }
      ],
      "sharedFiles": ["SPECIFICATION.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
      "extraSyncTargets": [
        { "source": "package:README.md", "dest": "src/texthue/_docs/README.md" },
        { "source": "root:SPECIFICATION.md", "dest": "src/texthue/_docs/SPECIFICATION.md" },
        { "source": "root:LICENSE", "dest": "src/texthue/_docs/LICENSE" },
        { "source": "root:THIRD_PARTY_NOTICES.md", "dest": "src/texthue/_docs/THIRD_PARTY_NOTICES.md" }
      ],
      "conformanceRunner": ["python", "tools/conformance-python.py"],
      "conformanceReplay": true,
      "coverageFlag": "python",
      "archiveRequiredFiles": [
        "__init__.py", "_core.py", "_types.py", "py.typed",
        "_docs/README.md", "_docs/SPECIFICATION.md", "_docs/LICENSE", "_docs/THIRD_PARTY_NOTICES.md"
      ],
      "publish": { "registry": "pypi", "packageName": "texthue" }
    },
    {
      "id": "go",
      "language": "go",
      "dir": "packages/go",
      "versionFiles": [],
      "sharedFiles": ["SPECIFICATION.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
      "extraSyncTargets": [
        { "source": "root:conformance/vectors.json", "dest": "testdata/vectors.json" }
      ],
      "conformanceRunner": ["go", "-C", "packages/go", "run", "./cmd/conformance"],
      "conformanceReplay": true,
      "coverageFlag": "go",
      "publish": { "registry": "go-module", "modulePath": "github.com/HusteDev/texthue/packages/go" }
    },
    {
      "id": "kotlin",
      "language": "kotlin",
      "dir": "packages/kotlin",
      "versionFiles": [
        { "path": "packages/kotlin/build.gradle", "kind": "pyRegex", "pattern": "^version = '([^']+)'$" }
      ],
      "sharedFiles": ["SPECIFICATION.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
      "verifyCommands": [["./gradlew", "check"]],
      "optionalToolchain": true,
      "conformanceRunner": ["packages/kotlin/gradlew", "-q", "-p", "packages/kotlin", "jsonConformance"]
    },
    {
      "id": "swift",
      "language": "swift",
      "dir": "packages/swift",
      "versionFiles": [],
      "sharedFiles": ["SPECIFICATION.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
      "extraSyncTargets": [
        { "source": "root:conformance/apca-srgb-v1.json", "dest": "Tests/TextHueTests/Fixtures/apca-srgb-v1.json" },
        { "source": "root:conformance/composite-v1.json", "dest": "Tests/TextHueTests/Fixtures/composite-v1.json" },
        { "source": "root:conformance/normalization-v1.json", "dest": "Tests/TextHueTests/Fixtures/normalization-v1.json" },
        { "source": "root:conformance/p3-contrast-v1.json", "dest": "Tests/TextHueTests/Fixtures/p3-contrast-v1.json" },
        { "source": "root:conformance/p3-fit-v1.json", "dest": "Tests/TextHueTests/Fixtures/p3-fit-v1.json" },
        { "source": "root:conformance/presets-v1.json", "dest": "Tests/TextHueTests/Fixtures/presets-v1.json" },
        { "source": "root:conformance/renderer-v1.json", "dest": "Tests/TextHueTests/Fixtures/renderer-v1.json" },
        { "source": "root:conformance/tone-repair-v1.tsv", "dest": "Tests/TextHueTests/Fixtures/tone-repair-v1.tsv" },
        { "source": "root:conformance/assign-vectors.json", "dest": "Tests/TextHueTests/Fixtures/assign-vectors.json" },
        { "source": "root:conformance/vectors.json", "dest": "Tests/TextHueTests/Fixtures/vectors.json" }
      ],
      "verifyCommands": [["swift", "test", "--force-resolved-versions"], ["python", "../../tools/check-swift-example.py"]],
      "optionalToolchain": true,
      "conformanceRunner": ["swift", "run", "--package-path", "packages/swift", "--force-resolved-versions", "TextHueConformance"]
    },
    {
      "id": "dart",
      "language": "dart",
      "dir": "packages/dart",
      "versionFiles": [
        { "path": "packages/dart/pubspec.yaml", "kind": "pyRegex", "pattern": "^version: ([^\\s]+)$" }
      ],
      "sharedFiles": ["SPECIFICATION.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
      "conformanceSetup": ["dart", "pub", "get", "--enforce-lockfile"],
      "verifyCommands": [["dart", "analyze", "--fatal-infos"], ["dart", "test"], ["dart", "run", "{suite}"]],
      "verifySuites": "tool/check_*.dart",
      "optionalToolchain": true,
      "conformanceRunner": ["dart", "run", "packages/dart/tool/conformance.dart"]
    },
    {
      "id": "csharp",
      "language": "csharp",
      "dir": "packages/csharp",
      "versionFiles": [
        { "path": "packages/csharp/src/TextHue/TextHue.csproj", "kind": "pyRegex", "pattern": "<Version>([^<]+)</Version>" }
      ],
      "sharedFiles": ["SPECIFICATION.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
      "verifyCommands": [["dotnet", "test", "--configuration", "Release", "tests/Behavior"], ["dotnet", "run", "--configuration", "Release", "--project", "tests/Conformance"]],
      "optionalToolchain": true,
      "conformanceRunner": ["dotnet", "run", "--configuration", "Release", "--project", "packages/csharp/tools/JsonRunner"]
    },
    {
      "id": "wasm",
      "language": "webassembly",
      "dir": "packages/wasm",
      "versionFiles": [
        { "path": "packages/wasm/package.json", "kind": "json", "field": "version" }
      ],
      "sharedFiles": ["SPECIFICATION.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
      "verifyCommands": [["python", "../../tools/build-wasm.py"], ["node", "../../tools/check-wasm.mjs"]],
      "conformanceRunner": null
    },
    {
      "id": "tailwind",
      "language": "javascript",
      "dir": "packages/tailwind",
      "versionFiles": [
        { "path": "packages/tailwind/package.json", "kind": "json", "field": "version" }
      ],
      "sharedFiles": ["LICENSE"],
      "verifyCommands": [["node", "--test", "../../tests/tailwind.test.mjs"]],
      "conformanceRunner": null
    },
    {
      "id": "react",
      "language": "javascript",
      "dir": "packages/react",
      "versionFiles": [
        { "path": "packages/react/package.json", "kind": "json", "field": "version" }
      ],
      "sharedFiles": ["LICENSE"],
      "verifyCommands": [["node", "--test", "../../tests/react.test.mjs"]],
      "conformanceRunner": null
    },
    {
      "id": "rust",
      "language": "rust",
      "dir": "packages/rust",
      "versionFiles": [
        { "path": "packages/rust/Cargo.toml", "kind": "toml", "field": ["package", "version"] }
      ],
      "sharedFiles": ["SPECIFICATION.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
      "extraSyncTargets": [
        { "source": "root:conformance/apca-srgb-v1.json", "dest": "testdata/apca-srgb-v1.json" },
        { "source": "root:conformance/normalization-v1.json", "dest": "testdata/normalization-v1.json" },
        { "source": "root:conformance/p3-contrast-v1.json", "dest": "testdata/p3-contrast-v1.json" },
        { "source": "root:conformance/p3-fit-v1.json", "dest": "testdata/p3-fit-v1.json" },
        { "source": "root:conformance/composite-v1.json", "dest": "testdata/composite-v1.json" },
        { "source": "root:conformance/presets-v1.json", "dest": "testdata/presets-v1.json" },
        { "source": "root:conformance/tone-repair-v1.tsv", "dest": "testdata/tone-repair-v1.tsv" },
        { "source": "root:conformance/assign-vectors.json", "dest": "testdata/assign-vectors.json" },
        { "source": "root:conformance/vectors.json", "dest": "testdata/vectors.json" }
      ],
      "verifyCommands": [
        ["cargo", "fmt", "--check"],
        ["cargo", "clippy", "--locked", "--all-targets", "--", "-D", "warnings"],
        ["cargo", "test", "--locked"]
      ],
      "optionalToolchain": true,
      "conformanceRunner": ["cargo", "run", "--quiet", "--locked", "--manifest-path", "packages/rust/Cargo.toml", "--example", "conformance"]
    }
  ]
}
