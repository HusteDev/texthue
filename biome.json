{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!artifacts",
      "!brag-output",
      "!.cache",
      "!.venv",
      "!coverage",
      "!package-lock.json",
      "!conformance/vectors.json",
      "!packages/go/testdata/vectors.json",
      "!packages/rust/testdata/vectors.json",
      "!packages/swift/Tests/TextHueTests/Fixtures/vectors.json"
    ]
  },
  "formatter": { "enabled": false },
  "overrides": [{
    "includes": ["packages/npm/src/**/*.ts", "!packages/npm/src/tables.ts"],
    "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
    "javascript": { "formatter": { "quoteStyle": "single" } }
  }],
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}
