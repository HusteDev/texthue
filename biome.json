{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!artifacts",
      "!.cache",
      "!.venv",
      "!coverage",
      "!package-lock.json",
      "!conformance/vectors.json",
      "!packages/go/testdata/vectors.json",
      "!packages/rust/testdata/vectors.json",
      "!packages/swift/Tests/TextHueTests/Fixtures/vectors.json"
    ]
  },
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  }
}
